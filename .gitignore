# Rust
/host/target/
**/*.rs.bk

# Swift / Xcode
.build/
.swiftpm/
*.xcuserstate
xcuserdata/
DerivedData/
# A leading path component makes a pattern root-anchored, so these need `**/` to reach the projects that actually
# exist (`apps/ios/OpenPaw.xcodeproj/...`). Without it Xcode's resolved-package state shows up as untracked noise
# every time the app is built.
**/*.xcodeproj/project.xcworkspace/
**/*.xcodeproj/xcuserdata/
Package.resolved.lock

# macOS
.DS_Store

# OpenPaw local state (never commit device tokens)
.openpaw/
/artifacts/

# Scratch build trees from the no-Xcode iOS typecheck path
.build-ios/
.build-*/
